# photo-intel.conf
# Single config file read by all photo-intel scripts.
#
# Copy this file to photo-intel.conf and edit the values for your setup.
# All scripts accept --config /path/to/photo-intel.conf to override the
# default location (same directory as the script).
#
# Mode "local" : entire pipeline runs on the Mac that holds the Photos library.
# Mode "split" : the Mac exports + rsyncs; a separate Linux/GPU machine runs
#                Phase 1/2, the database, and the web app.

[general]
mode = split

[paths]
# --- export side (Mac running Apple Photos) ---
# Path to your Photos Library bundle.
library        = /Volumes/MyPhotos/Photos Library.photoslibrary

# Persistent staging directory for osxphotos --update exports.
# NEVER clear this between runs — it is the --update anchor.
# Must be on a volume that stays mounted between export cycles.
staging_dir    = /Volumes/MyDrive/photo-intel/staging

# osxphotos export-state DB (outside staging so it survives staging clears).
exportdb       = /Users/youruser/photo-intel/osxphotos_export.db

# --- processing side (local mode: same Mac; split mode: remote host) ---
dest_dir       = /path/to/photo-intel/photos
db_path        = /path/to/photo-intel/photo-intel.db

[transfer]
# rsync target — split mode only. Leave blank for local mode.
rsync_dest     = youruser@processing-host:/path/to/photo-intel/photos
ssh_key        = /Users/youruser/.ssh/id_ed25519

[ollama]
# Ollama endpoint and model used by Phase 2 (enrichment) and the web app
# Smart Search / voice query expansion.
url            = http://localhost:11434
model          = gemma4:12b-it-q8_0

[export]
# Year windows for chunked export.
# "pre1980" collapses everything before 1980 into one window.
# Add the current year each January.
windows =
    pre1980
    1980
    1981
    1982
    1983
    1984
    1985
    1986
    1987
    1988
    1989
    1990
    1991
    1992
    1993
    1994
    1995
    1996
    1997
    1998
    1999
    2000
    2001
    2002
    2003
    2004
    2005
    2006
    2007
    2008
    2009
    2010
    2011
    2012
    2013
    2014
    2015
    2016
    2017
    2018
    2019
    2020
    2021
    2022
    2023
    2024
    2025
    2026

[phase2]
# Gemma token budget per photo. 1024 works well for gemma4:12b.
# Raise num_predict_retry for a second attempt on truncated JSON.
enable_thinking  = false
num_predict      = 1024
num_predict_retry = 2048
request_timeout  = 180

[video]
# Phase 2b — video enrichment (photo_intel_video.py). Optional: omit this
# whole section if you only care about still images. Requires ffmpeg/ffprobe
# on PATH for frame extraction.
#
# Vision-language model used to describe clips. Runs on the same Ollama
# endpoint as [ollama] above, but is a different model — the script unloads
# the Phase 2 gemma model to free VRAM, runs, then warms gemma back.
model              = qwen3-vl:8b
# The model warmed back after the run (should match [ollama] model).
gemma_model        = gemma4:12b-it-q8_0
# Frames sampled per clip, evenly spaced, sent as one ordered frameset.
frames             = 12
# Clips shorter than this (seconds) are marked permanently skipped.
min_duration       = 2.0
num_ctx            = 32768
num_predict        = 2048
num_predict_retry  = 3072
request_timeout    = 300
# Holds the VLM in VRAM between clips so it is not reloaded per clip.
keep_alive         = 15m
# Self-imposed wall-clock stop, in minutes from start. Sized so the run always
# ends and warms gemma back before the next scheduled Ollama job. MUST stay
# below TimeoutStartSec in photo-intel-video.service — the two move together.
max_minutes        = 640

[web]
# Shared secret for the photo-delete endpoint (POST /api/delete).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Leave blank to disable photo deletion entirely.
delete_token = YOUR_DELETE_TOKEN_HERE
