<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.photo-intel.export-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/youruser/photo-intel/export_watchdog.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/youruser/photo-intel</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/youruser/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Optional: uncomment and point at a script that delivers alerts
             (subject as $1, body on stdin). Without it, alerts only go to
             watchdog.log.
        <key>PHOTO_INTEL_NOTIFY_CMD</key>
        <string>/Users/youruser/photo-intel/notify.sh</string>
        -->
    </dict>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    <key>StartInterval</key>
    <integer>7200</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/youruser/photo-intel/watchdog-launchd.err</string>
    <key>StandardErrorPath</key>
    <string>/Users/youruser/photo-intel/watchdog-launchd.err</string>
</dict>
</plist>
