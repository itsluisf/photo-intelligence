[Unit]
Description=photo-intel Phase 1 sidecar ingest
After=network.target

[Service]
Type=oneshot
User=luis
WorkingDirectory=/home/luis/photo-intel
ExecStart=/usr/bin/python3 /home/luis/photo-intel/photo_intel_phase1.py --once
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
