[Unit]
Description=photo-intel Phase 2 Gemma enrichment
After=network-online.target photo-intel-phase1.service
Wants=network-online.target

[Service]
Type=oneshot
User=youruser
Group=youruser
WorkingDirectory=/home/youruser/photo-intel
ExecStart=/home/youruser/photo-intel/venv/bin/python /home/youruser/photo-intel/photo_intel_phase2.py
Nice=10
TimeoutStartSec=21600
