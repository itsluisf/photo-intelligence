[Unit]
Description=Photo Intel Phase 1 ingest (every 2h)
# No Requires=photo-intel-phase1.service here: a .timer already triggers
# its matching .service via the implicit Unit= on the OnCalendar schedule. A
# Requires= (or Wants=) on the timer's [Unit] additionally starts the service
# the instant the timer itself is started/enabled/booted — not only on
# schedule, which fires an unscheduled run every time you edit and restart
# the timer.

[Timer]
OnCalendar=*-*-* 00/2:30:00
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
